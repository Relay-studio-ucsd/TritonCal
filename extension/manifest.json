{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.7.0",
  "default_locale": "en",
  "description": "__MSG_description__",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://tss.ucsd.edu/*"],
      "js": ["sites/tss/capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://tss.ucsd.edu/*"],
      "js": [
        "shared/locales.js", "shared/i18n.js",
        "sites/tss/parser.js", "sites/tss/plan.js",
        "shared/ics.js", "shared/offline.js",
        "sites/tss/week-view.js", "sites/tss/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
