{
  "manifest_version": 3,
  "name": "TritonCal · 本周课表实验版",
  "version": "0.5.1",
  "description": "只读取 TSS 页面已加载的课表响应，显示周课表并导出日历或手机离线课表。",
  "action": {
    "default_title": "查看本周课表",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://tss.ucsd.edu/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://tss.ucsd.edu/*"],
      "js": ["parser.js", "ics.js", "offline.js", "week-view.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
